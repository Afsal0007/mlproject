# Frontend environment variables (copy to .env.local for local Vite development)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=/api

# DEV ONLY — bypasses all authentication and RLS. NEVER set true outside local dev.
# Must be false (or removed) before Phase 12 security hardening.
# Leave unset or set to false by default.
VITE_DEV_BYPASS_AUTH=false
