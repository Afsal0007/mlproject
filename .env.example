# =============================================================
# Placement AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# ----------------------------
# Application
# ----------------------------
APP_NAME="Placement AI"
APP_ENV=development          # development | staging | production
DEBUG=true

# ----------------------------
# Backend API
# ----------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# ----------------------------
# Security / JWT
# ----------------------------
SECRET_KEY=changeme_use_openssl_rand_hex_32_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----------------------------
# Database
# ----------------------------
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/placement_ai

# SQLite (local dev — override DATABASE_URL in your local .env)
# DATABASE_URL=sqlite+aiosqlite:///./placement_ai.db

# ----------------------------
# ML
# ----------------------------
ML_MODEL_DIR=backend/ml/models
ML_MODEL_VERSION=v1

# ----------------------------
# Frontend
# ----------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="Placement AI"

# ----------------------------
# Optional: Email (for notifications)
# ----------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=changeme

# ----------------------------
# Optional: Cloud Storage (resume uploads)
# ----------------------------
S3_BUCKET=placement-ai-resumes
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
