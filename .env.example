# =============================================================
# PlacementAI — Environment Variables Template
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# ── Frontend (Vite — must be prefixed VITE_) ─────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://127.0.0.1:5000/api

# ── Backend (Flask) ───────────────────────────────────────────
FLASK_ENV=development           # development | production

# DEV ONLY — bypasses all authentication and RLS. NEVER set true outside local dev.
# Must be false (or removed) before Phase 12 security hardening.
DEV_BYPASS_AUTH=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional — only needed if verifying JWTs locally with HS256 (legacy).
# Supabase projects issued after mid-2023 use RS256; use the JWKS endpoint instead.
SUPABASE_JWT_SECRET=

# Flask secret key — run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-key

# CORS — comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML
MODEL_DIR=ml/artifacts
